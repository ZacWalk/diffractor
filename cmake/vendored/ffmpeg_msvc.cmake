# Purpose: Build Diffractor's FFmpeg fork, fetched by FFmpeg.cmake, as diffractor::ffmpeg_msvc.
#
# Imported from the fork's ffmpeg.vcxproj (Release|x64) by tools/import_vcxproj.py.
# Compiler and linker flags are not restated here: DiffractorCompilerPolicy.cmake owns those
# for every target.

include_guard(GLOBAL)

# The fork checks in one pre-generated nasm config per architecture, because FFmpeg's configure
# needs a shell that Windows does not have. The importer read the Release|x64 configuration, so it
# emitted the x64 file for every architecture, and a 32-bit assemble of any of these sources then
# failed with "impossible combination of address sizes" -- the config says ARCH_X86_64 while nasm
# is emitting win32. Selected by target here rather than baked in.
if (DIFFRACTOR_TARGET_ARCH STREQUAL "x86")
    set(_ffmpeg_config_asm "${ffmpeg_SOURCE_DIR}/config-x86.asm")
else ()
    set(_ffmpeg_config_asm "${ffmpeg_SOURCE_DIR}/config-x64.asm")
endif ()

# These assembly sources share a file name with another in this library, and CMake names a
# nasm object after the file name alone. Copied under a name that is unique so that no
# generator's object directory can let one quietly overwrite the other.
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/hevc/mc.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_hevc_mc.asm" COPYONLY)
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/hevc/sao.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_hevc_sao.asm" COPYONLY)
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/hevc/sao_10bit.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_hevc_sao_10bit.asm" COPYONLY)
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/vvc/mc.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_vvc_mc.asm" COPYONLY)
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/vvc/sao.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_vvc_sao.asm" COPYONLY)
configure_file("${ffmpeg_SOURCE_DIR}/libavcodec/x86/vvc/sao_10bit.asm"
        "${CMAKE_BINARY_DIR}/vendored/ffmpeg_msvc-asm/third-party_FFmpeg_libavcodec_x86_vvc_sao_10bit.asm" COPYONLY)

