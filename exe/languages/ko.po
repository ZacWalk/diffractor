msgid_plural "A desktop email draft will be opened with {count} selected items attached."
msgstr[0] "{first-name}을(를) 첨부한 임시 보관 메일이 데스크톱 이메일 클라이언트에서 열립니다."
msgstr[1] "선택한 항목 {count}개를 첨부한 임시 보관 메일이 데스크톱 이메일 클라이언트에서 열립니다."

msgid "{first-name} will be offered to the app you choose."
msgid_plural "{count} selected items will be offered to the app you choose."
