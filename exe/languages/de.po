msgstr "Rendern"

msgid "Write the movie to a video file."
msgstr "Schreibt den Film in eine Videodatei."

msgid "Relink missing files"
msgstr "Fehlende Dateien neu verknüpfen"

msgid "Point clips whose source file has moved at a folder you choose."
msgstr "Verweist Clips, deren Quelldatei verschoben wurde, auf einen von Ihnen gewählten Ordner."

msgid "1 element of the imported project was left out because Movie cannot represent it."
msgid_plural "{count} elements of the imported project were left out because Movie cannot represent them."
msgstr[0] "1 Element des importierten Projekts wurde ausgelassen, weil Film es nicht abbilden kann."
msgstr[1] "{count} Elemente des importierten Projekts wurden ausgelassen, weil Film sie nicht abbilden kann."

msgid "1 clip cannot find its source file."
msgid_plural "{count} clips cannot find their source files."
msgstr[0] "1 Clip findet seine Quelldatei nicht."
msgstr[1] "{count} Clips finden ihre Quelldateien nicht."

msgid "1 clip was relinked."
msgid_plural "{count} clips were relinked."
msgstr[0] "1 Clip wurde neu verknüpft."
msgstr[1] "{count} Clips wurden neu verknüpft."

