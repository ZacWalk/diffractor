msgid_plural "{count} selected items will be offered to the app you choose."
msgstr[0] "{first-name} wird der App angeboten, die Sie auswählen."
msgstr[1] "{count} ausgewählte Items werden der App angeboten, die Sie auswählen."

msgid "{first-name} already exists. Do you want to replace it?"
msgid_plural "{first-name} and {other} other items already exist. Do you want to replace them?"
msgstr[0] "{first-name} ist bereits vorhanden. Möchten Sie es ersetzen?"
msgstr[1] "{first-name} und {other} andere Items sind bereits vorhanden. Möchten Sie diese ersetzen?"

msgid "{first-name} will have existing GPS position metadata overwritten."
msgid_plural "{first-name} and {other} other items will have existing GPS position metadata overwritten."
msgstr[0] "Bei {first-name} werden vorhandene GPS-Positionsmetadaten überschrieben."
msgstr[1] "Bei {first-name} und {other} anderen Items werden vorhandene GPS-Positionsmetadaten überschrieben."

msgid "Choose a valid new starting date and time."
msgstr "Wählen Sie ein gültiges neues Anfangsdatum mit Uhrzeit."

msgid "Windows could not stage the selected items for disc burning."
msgstr "Windows konnte die ausgewählten Items nicht zum Brennen auf Disc inszenieren."

msgid "The selected items will be staged in Windows Disc Burning. Windows will guide you through writing the disc."
msgstr "Die ausgewählten Items werden für das Brennen der Disc in Windows inszeniert. Windows führt Sie durch das Schreiben der Disc."

msgid "&Stage files"
msgstr "Dateien &inszenieren"

msgid "Email draft was canceled."
msgstr "E-Mail-Entwurf wurde abgebrochen."

msgid "Maximum dimension must be at least 1 pixel."
msgstr "Maximale Dimension muss mindestens 1 Pixel betragen."

msgid "Select at least one metadata field to update. Checked empty fields clear existing values; unchecked fields are unchanged."
msgstr "Wählen Sie mindestens ein zu aktualisierendes Metadatenfeld aus. Markierte leere Felder löschen vorhandene Werte; nicht markierte Felder bleiben unverändert."

msgid "{first-name} was canceled."
msgid_plural "{count} items were canceled."
msgstr[0] "{first-name} wurde abgebrochen."
msgstr[1] "{count} Items wurden abgebrochen."

msgid "{first-name} will be staged for disc burning."
msgid_plural "{count} selected items ({size}) will be staged for disc burning."
msgstr[0] "{first-name} wird zum Brennen der Disc inszeniert."
msgstr[1] "{count} ausgewählte Items ({size}) werden zum Brennen der Disc inszeniert."

