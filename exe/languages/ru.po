msgstr "Местом назначения является DVD-диск, доступный только для чтения, возможно, неформатированный."

msgid "The source and destination have the same parent folder."
msgstr "Источник и место назначения имеют одну и ту же родительскую папку."

msgid "The destination is a subtree of the source."
msgstr "Назначением является поддерево источника."

msgid "Rename operation was specified but the destination path is a different directory. Use the move operation instead."
msgstr "Была указана операция переименования, но путь назначения — это другой каталог. Вместо этого используйте операцию перемещения."

msgid "Destination is a root directory and cannot be renamed."
msgstr "Назначением является корневой каталог, и его нельзя переименовать."

msgid "The destination path is an existing folder."
msgstr "Путь назначения — это существующая папка."

msgid "The file involved in the operation is too large for the destination media or file system."
msgstr "Файл, участвующий в операции, слишком велик для целевого носителя или файловой системы."

msgid "The name of the file exceeds MAX_PATH."
msgstr "Имя файла превышает MAX_PATH."

msgid "The destination path is an existing file."
msgstr "Путь назначения — это существующий файл."

msgid "Index database failed."
msgstr "База данных индекса не удалась."

msgid "The path in the source or destination or both was invalid."
msgstr "Путь в источнике или месте назначения (или в обоих) недействителен."

msgid "The file name you have chosen '{}' is invalid."
msgstr "Выбранное вами имя файла «{}» неверно."

msgid "File names cannot contain the following characters:"
msgstr "Имена файлов не могут содержать следующие символы:"

msgid "The operation involved multiple destination paths, which can fail in the case of a move operation."
msgstr "В операции задействовано несколько путей назначения, что может привести к сбою в случае операции перемещения."

msgid "Multiple file paths were specified in the source buffer, but only one destination file path."
msgstr "В исходном буфере было указано несколько путей к файлам, но только один путь к целевому файлу."

msgid "MAX_PATH was exceeded during the operation."
msgstr "Во время операции было превышено значение MAX_PATH."

msgid "OleInitialize Failed"
msgstr "Ошибка OleInitialize"

msgid "An unspecified error occurred on the destination."
msgstr "В месте назначения произошла неизвестная ошибка."

msgid "The operation was canceled."
msgstr "Операция отменена."

msgid "The analysis was canceled."
msgstr "Анализ отменён."

msgid "Cancel"
msgstr "Отмена"

msgid "The source or destination path exceeded or would exceed MAX_PATH."
