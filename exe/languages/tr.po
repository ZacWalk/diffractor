msgid "Assemble the selected photos and videos into one video."
msgstr "Seçili fotoğrafları ve videoları tek bir videoda birleştirir."

msgid "Add files"
msgstr "Dosya ekle"

msgid "Remove from movie"
msgstr "Filmden kaldır"

msgid "Send to the end"
msgstr "Sona gönder"

msgid "Open project"
msgstr "Projeyi aç"

msgid "Save project"
msgstr "Projeyi kaydet"

msgid "Import Movie Maker project"
msgstr "Movie Maker projesini içe aktar"

msgid "Video"
msgstr "Video"

msgid "Rendering the movie"
msgstr "Film işleniyor"

msgid "The movie could not be rendered. {}"
msgstr "Film işlenemedi. {}"

msgid "The movie has no length."
msgstr "Filmin süresi yok."

msgid "The encoder would not accept this movie."
msgstr "Kodlayıcı bu filmi kabul etmedi."

msgid "There was not enough memory for a movie frame."
msgstr "Bir film karesi için yeterli bellek yoktu."

msgid "A clip could not be decoded."
msgstr "Bir klibin kodu çözülemedi."

msgid "The encoder stopped before the movie was finished."
msgstr "Kodlayıcı, film tamamlanmadan durdu."

msgid "That name belongs to a clip in this movie. Choose another name."
msgstr "Bu ad, bu filmdeki bir klibe ait. Başka bir ad seçin."

msgid "Rendered {}."
msgstr "{} işlendi."

msgid "Rendering was canceled. Nothing was written."
msgstr "İşleme iptal edildi. Hiçbir şey yazılmadı."

msgid "No missing clip was found in that folder."
msgstr "Bu klasörde eksik klip bulunamadı."

msgid "This movie has changes that are not in a project file. It is kept while Diffractor is running, and closing Diffractor discards it."
msgstr "Bu filmde hiçbir proje dosyasında bulunmayan değişiklikler var. Diffractor çalıştığı sürece korunur, Diffractor kapatılınca atılır."

msgid "Close without saving"
msgstr "Kaydetmeden kapat"

msgid "Render"
msgstr "İşle"

msgid "Write the movie to a video file."
msgstr "Filmi bir video dosyasına yazar."

msgid "Relink missing files"
msgstr "Eksik dosyaları yeniden bağla"

msgid "Point clips whose source file has moved at a folder you choose."
msgstr "Kaynak dosyası taşınmış klipleri seçtiğiniz bir klasöre yönlendirir."

msgid "1 element of the imported project was left out because Movie cannot represent it."
msgid_plural "{count} elements of the imported project were left out because Movie cannot represent them."
msgstr[0] "İçe aktarılan projenin 1 ögesi, Film onu temsil edemediği için dışarıda bırakıldı."
msgstr[1] "İçe aktarılan projenin {count} ögesi, Film onları temsil edemediği için dışarıda bırakıldı."

msgid "1 clip cannot find its source file."
msgid_plural "{count} clips cannot find their source files."
msgstr[0] "1 klip kaynak dosyasını bulamıyor."
msgstr[1] "{count} klip kaynak dosyalarını bulamıyor."

msgid "1 clip was relinked."
msgid_plural "{count} clips were relinked."
msgstr[0] "1 klip yeniden bağlandı."
msgstr[1] "{count} klip yeniden bağlandı."

